@ECHO OFF
REM Native MS-DOS 2.00 / 4.00 / 7.x Self-Hosting Build Script (Strict 8.3)
REM Usage: BUILD [NASM|FASM|JWASM|CLEAN]

IF "%1"=="CLEAN" GOTO :DO_CLEAN
IF "%1"=="clean" GOTO :DO_CLEAN
IF "%1"=="FASM" GOTO :DO_FASM
IF "%1"=="JWASM" GOTO :DO_JWASM

:DO_NASM
ECHO [DOS16] Assembling WINCMD, WINCMD1, ASMCONV, and 19 .COM utilities with NASM...
NASM -Ox -w+all -w-reloc -w+error -I DIST\SRC\NASM\DOS16\ -f bin DIST\SRC\NASM\DOS16\WINCMD.ASM -o WINCMD.COM
IF ERRORLEVEL 1 GOTO :FAIL
NASM -Ox -w+all -w-reloc -w+error -I DIST\SRC\NASM\DOS16\ -f bin DIST\SRC\NASM\DOS16\WINCMD1.ASM -o WINCMD1.COM
IF ERRORLEVEL 1 GOTO :FAIL
NASM -Ox -w+all -w-reloc -w+error -f bin DIST\SRC\NASM\DOS16\WINCMD_M.ASM -o WINCMD.MSG
IF ERRORLEVEL 1 GOTO :FAIL
NASM -Ox -w+all -w-reloc -w+error -f bin DIST\SRC\NASM\DOS16\UTIL\ASMCONV.ASM -o ASMCONV.COM
IF ERRORLEVEL 1 GOTO :FAIL
FOR %%U IN (MEM ATTRIB FIND FINDSTR SORT MORE FC COMP TREE WHERE XCOPY REPLACE ROBOCOPY CHOICE TIMEOUT TRUENAME REG HOSTNAME WHOAMI) DO NASM -Ox -w+all -w-reloc -w+error -I DIST\SRC\NASM\DOS16\UTIL\ -f bin DIST\SRC\NASM\DOS16\UTIL\%%U.ASM -o %%U.COM
IF ERRORLEVEL 1 GOTO :FAIL
IF "%1"=="NASM" GOTO :DONE

:DO_FASM
IF "%1"=="NASM" GOTO :DONE
ECHO [DOS16] Assembling WINCMD, WINCMD1, ASMCONV, and 19 .COM utilities with FASM...
FASM DIST\SRC\FASM\DOS16\WINCMD.ASM WINCMDF.COM
IF ERRORLEVEL 1 GOTO :FAIL
FASM DIST\SRC\FASM\DOS16\WINCMD1.ASM WINCMD1F.COM
IF ERRORLEVEL 1 GOTO :FAIL
FASM DIST\SRC\FASM\DOS16\UTIL\ASMCONV.ASM ASMCONVF.COM
IF ERRORLEVEL 1 GOTO :FAIL
FOR %%U IN (MEM ATTRIB FIND FINDSTR SORT MORE FC COMP TREE WHERE XCOPY REPLACE ROBOCOPY CHOICE TIMEOUT TRUENAME REG HOSTNAME WHOAMI) DO FASM DIST\SRC\FASM\DOS16\UTIL\%%U.ASM %%U.COM
IF ERRORLEVEL 1 GOTO :FAIL
IF "%1"=="FASM" GOTO :DONE

:DO_JWASM
ECHO [DOS16] Assembling WINCMD, WINCMD1, ASMCONV, and 19 .COM utilities with JWasm...
JWASM -q -WX -W4 -IDIST\SRC\JWASM\DOS16 -bin -FoWINCMDJ.COM DIST\SRC\JWASM\DOS16\WINCMD.ASM
IF ERRORLEVEL 1 GOTO :FAIL
JWASM -q -WX -W4 -IDIST\SRC\JWASM\DOS16 -bin -FoWINCMD1J.COM DIST\SRC\JWASM\DOS16\WINCMD1.ASM
IF ERRORLEVEL 1 GOTO :FAIL
JWASM -q -WX -W4 -bin -FoASMCONVJ.COM DIST\SRC\JWASM\DOS16\UTIL\ASMCONV.ASM
IF ERRORLEVEL 1 GOTO :FAIL
FOR %%U IN (MEM ATTRIB FIND FINDSTR SORT MORE FC COMP TREE WHERE XCOPY REPLACE ROBOCOPY CHOICE TIMEOUT TRUENAME REG HOSTNAME WHOAMI) DO JWASM -q -WX -W4 -IDIST\SRC\JWASM\DOS16\UTIL -bin -Fo%%U.COM DIST\SRC\JWASM\DOS16\UTIL\%%U.ASM
IF ERRORLEVEL 1 GOTO :FAIL
GOTO :DONE

:DO_CLEAN
FOR %%F IN (WINCMD WINCMDF WINCMDJ WINCMD1 WINCMD1F WINCMD1J ASMCONV ASMCONVF ASMCONVJ MEM ATTRIB FIND FINDSTR SORT MORE FC COMP TREE WHERE XCOPY REPLACE ROBOCOPY CHOICE TIMEOUT TRUENAME REG HOSTNAME WHOAMI) DO IF EXIST %%F.COM DEL %%F.COM
IF EXIST WINCMD.MSG DEL WINCMD.MSG
GOTO :DONE

:FAIL
ECHO BUILD.BAT FAILED.
EXIT /B 1

:DONE
ECHO BUILD.BAT SUCCEEDED.

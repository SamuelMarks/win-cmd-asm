# ------------------------------------------------------------------------------
# 2. Multi-ISA Assembly Sources, Headers & Linker Definitions (Strict LF)
# ------------------------------------------------------------------------------
*.asm     text eol=lf linguist-language=Assembly
*.ASM     text eol=lf linguist-language=Assembly
*.inc     text eol=lf linguist-language=Assembly
*.INC     text eol=lf linguist-language=Assembly
*.mac     text eol=lf linguist-language=Assembly
*.MAC     text eol=lf linguist-language=Assembly
*.s       text eol=lf linguist-language=Assembly
*.S       text eol=lf linguist-language=Assembly
*.def     text eol=lf
*.DEF     text eol=lf
*.ld      text eol=lf
*.lds     text eol=lf

# ------------------------------------------------------------------------------
# 3. MS-DOS, Win16 & Windows Batch, Command, Registry & MSBuild (Strict CRLF)
#    MS-DOS COMMAND.COM & Windows CMD.EXE require CRLF for byte-offset seeking.
# ------------------------------------------------------------------------------
*.bat              text eol=crlf linguist-language=Batchfile
*.BAT              text eol=crlf linguist-language=Batchfile
*.cmd              text eol=crlf linguist-language=Batchfile
*.CMD              text eol=crlf linguist-language=Batchfile
*.btm              text eol=crlf linguist-language=Batchfile
*.BTM              text eol=crlf linguist-language=Batchfile
AUTOEXEC.BAT       text eol=crlf linguist-language=Batchfile
autoexec.bat       text eol=crlf linguist-language=Batchfile
CONFIG.SYS         text eol=crlf
config.sys         text eol=crlf
*.reg              text eol=crlf
*.REG              text eol=crlf
*.inf              text eol=crlf
*.INF              text eol=crlf
*.ini              text eol=crlf
*.INI              text eol=crlf
*.rc               text eol=crlf
*.RC               text eol=crlf
*.dlg              text eol=crlf
*.DLG              text eol=crlf
*.mc               text eol=crlf
*.MC               text eol=crlf
*.ps1              text eol=crlf
*.psm1             text eol=crlf
*.psd1             text eol=crlf
*.vbs              text eol=crlf
*.VBS              text eol=crlf
*.wsf              text eol=crlf
*.WSF              text eol=crlf
*.sln              text eol=crlf
*.vcxproj          text eol=crlf
*.vcxproj.filters  text eol=crlf
*.props            text eol=crlf
*.targets          text eol=crlf

# ------------------------------------------------------------------------------
# 4. Rust Host Tooling, C/C++, POSIX Shell, Makefiles & Git Hooks (Strict LF)
# ------------------------------------------------------------------------------
*.rs                       text eol=lf diff=rust linguist-language=Rust
*.toml                     text eol=lf
Cargo.lock                 text eol=lf
*.c                        text eol=lf diff=cpp
*.h                        text eol=lf diff=cpp
*.cpp                      text eol=lf diff=cpp
*.hpp                      text eol=lf diff=cpp
*.cc                       text eol=lf diff=cpp
*.cxx                      text eol=lf diff=cpp
*.sh                       text eol=lf linguist-language=Shell
*.bash                     text eol=lf linguist-language=Shell
*.zsh                      text eol=lf linguist-language=Shell
*.awk                      text eol=lf
*.sed                      text eol=lf
Makefile                   text eol=lf
GNUmakefile                text eol=lf
makefile                   text eol=lf
*.mk                       text eol=lf
.githooks/*                text eol=lf linguist-language=Shell
.githooks/*.cmd            text eol=crlf linguist-language=Batchfile
.githooks/*.bat            text eol=crlf linguist-language=Batchfile

